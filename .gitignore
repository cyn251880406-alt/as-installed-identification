# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Simulation output (does not go into the repository)
artifacts/
*.mp4
logs/

# Local scratch plans / traces
plans.local.json
trace.json

# Demo video/GIF and diagnostic archives: large, and reproducible with a single command
authoring/media/
authoring/diagnostics/
# Sandboxes from the LLM agent scoring runs (each is a scene copy plus logs): keep the
# README and the results, ignore the sandbox itself
authoring/eval/attempt-*/

# Per-run logs from the Docker verification (large; the index is kept, the run directories
# are ignored). Same policy as authoring/media/ and authoring/diagnostics/: the conclusions
# go into the README and the replayable scripts, and the raw per-run logs stay on the local
# machine only.
!authoring/results/
authoring/results/docker/*/

# Sandboxes from the difficulty search (same policy as attempt-*/ above: the run directories
# stay local, the conclusions live in authoring/evidence/FINDINGS-*.md and the instances are
# rebuilt in one command -- authoring/tools/make_instance_sandbox.py).
authoring/eval/agent-r3-*/
authoring/eval/cal-*/
